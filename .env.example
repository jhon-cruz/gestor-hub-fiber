# Copie para .env e substitua todos os valores marcados como CHANGE_ME.
COMPOSE_PROJECT_NAME=gestor-hub-fiber
APP_HTTP_PORT=3030

POSTGRES_DB=gestor_hub_fiber
POSTGRES_USER=gestor_hub
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Gere com: openssl rand -hex 32
APP_JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ACCESS_TOKEN_MINUTES=30

# Modo recomendado para produção. Use chaves distintas e restritas no Google Cloud.
# Enquanto as chaves não estiverem configuradas, mantenha openstreetmap/nominatim.
APP_MAP_PROVIDER=openstreetmap
# APP_GOOGLE_MAPS_BROWSER_API_KEY=chave-restrita-por-referer
APP_GEOCODING_ENABLED=true
APP_GEOCODING_PROVIDER=nominatim
APP_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# APP_GEOCODING_API_KEY=chave-restrita-por-ip-para-google-ou-geoapify
APP_GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode
APP_VIACEP_ENABLED=true
APP_GEOCODING_CACHE_DAYS=30
APP_CORS_ORIGINS=["http://localhost:3030"]
